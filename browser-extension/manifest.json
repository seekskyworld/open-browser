{
  "manifest_version": 3,
  "name": "open-browser",
  "version": "0.1.0",
  "description": "管理本机 Agent 工作区与 Chromium 标签组",
  "key": "",
  "permissions": [
    "debugger",
    "tabGroups",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "open-browser 工作区",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/open-browser-16.png",
      "32": "icons/open-browser-32.png",
      "48": "icons/open-browser-48.png",
      "128": "icons/open-browser-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/open-browser-16.png",
    "32": "icons/open-browser-32.png",
    "48": "icons/open-browser-48.png",
    "128": "icons/open-browser-128.png"
  }
}
