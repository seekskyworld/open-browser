+bool InputHandler::AllowGuardedInput(const blink::WebInputEvent& event) {
+  if (event.GetModifiers() & blink::WebInputEvent::kFromDebugger) {
+    return true;
+  }
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseDown ||
+      event.GetType() == blink::WebInputEvent::Type::kTouchStart) {
+    frontend_->OpenBrowserInputBlocked();
+  }
+  return false;
+}
+
+Response InputHandler::SetOpenBrowserInputGuard(bool enabled) {
+  if (enabled && !web_contents_) {
+    return Response::ServerError("No attached WebContents");
+  }
+  guard_requested_ = enabled;
+  if (!enabled) {
+    input_guard_.reset();
+  } else if (!input_guard_) {
+    // The callback is removed with the session-owned token.
+    input_guard_ = web_contents_->IgnoreInputEvents(base::BindRepeating(
+        &InputHandler::AllowGuardedInput, base::Unretained(this)));
+  }
+  return Response::Success();
+}
