+IN_PROC_BROWSER_TEST_F(SyntheticMouseEventTest, OpenBrowserInputGuard) {
+  NavigateToURLBlockUntilNavigationsComplete(shell(), GURL("about:blank"), 1);
+  Attach();
+  auto* contents = shell()->web_contents();
+  ASSERT_TRUE(ExecJs(contents, "window.count = 0; onclick = () => ++count;"));
+  auto physical_click = [&]() {
+    SimulateMouseClickAt(contents, 0, blink::WebMouseEvent::Button::kLeft,
+                         gfx::Point(15, 15));
+  };
+  physical_click();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return EvalJs(contents, "count").ExtractInt() == 1;
+  }));
+  base::DictValue params;
+  params.Set("enabled", true);
+  ASSERT_TRUE(
+      SendCommandSync("Input.setOpenBrowserInputGuard", std::move(params)));
+  for (int i = 0; i < 100; ++i) {
+    physical_click();
+    WaitForNotification("Input.openBrowserInputBlocked", true);
+    EXPECT_EQ(i + 1, EvalJs(contents, "count"));
+    SendMouseEvent("mousePressed", 15, 15, "left", true);
+    SendMouseEvent("mouseReleased", 15, 15, "left", true);
+    ASSERT_EQ(i + 2, EvalJs(contents, "count"));
+  }
+  Detach();
+  physical_click();
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    return EvalJs(contents, "count").ExtractInt() == 102;
+  }));
+}
